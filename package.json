{
  "name": "smartlog-analyzer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter smartlog-api build",
    "build:web": "pnpm --filter smartlog-web build",
    "start:api": "pnpm --filter smartlog-api start:dev",
    "start:web": "pnpm --filter smartlog-web start",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:web",
    "test:unit": "pnpm --filter smartlog-api exec jest --config ../../tests/jest.unit.config.cjs --runInBand",
    "test:integration": "pnpm --filter smartlog-api exec jest --config ../../tests/jest.integration.config.cjs --runInBand",
    "test:web": "pnpm --filter smartlog-web exec ng test --watch=false"
  }
}
