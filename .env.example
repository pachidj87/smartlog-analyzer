# Puertos publicados en la máquina local
API_PORT=3000
WEB_PORT=4200
MONGO_PORT=27017

# Valores locales de ejemplo. Reemplazarlos antes de cualquier uso compartido.
MONGO_INITDB_ROOT_USERNAME=smartlog
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DATABASE=smartlog

# La API aún no abre una conexión MongoDB; esta variable prepara la configuración.
MONGODB_URI=mongodb://smartlog:change-me@mongodb:27017/smartlog?authSource=admin
