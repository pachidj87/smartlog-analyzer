# Aplicación y punto de entrada HTTP público
NODE_ENV=production
API_PORT=3000
PROXY_PORT=8080
HTTP_AUTH_USERNAME=smartlog
HTTP_AUTH_PASSWORD=replace-me
MONGO_PORT=27017
REDIS_PORT=6379

# Imágenes de infraestructura
MONGODB_IMAGE=mongo:8.0-noble
REDIS_IMAGE=redis:7-alpine

# Credenciales de desarrollo de ejemplo; reemplazarlas fuera de un entorno local.
MONGODB_INITDB_ROOT_USERNAME=smartlog
MONGODB_INITDB_ROOT_PASSWORD=change-me
MONGODB_DATABASE=smartlog
APP_BASE_URL=http://localhost:3000/
APP_BASE_URL_DOCKER=http://api:3000/
MONGODB_URI=mongodb://smartlog:change-me@localhost:27017/smartlog?authSource=admin
MONGODB_URI_DOCKER=mongodb://smartlog:change-me@mongodb:27017/smartlog?authSource=admin
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379
REDIS_URL_DOCKER=redis://:change-me@redis:6379
CACHE_TTL_SECONDS=30
HEALTH_CHECK_MEMORY_HEAP_LIMIT=250
HEALTH_CHECK_MEMORY_RSS_LIMIT=350

# Proveedores AI nativos. Sustituye credenciales por claves válidas.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
AI_REQUEST_TIMEOUT_MS=15000
AI_HEALTH_TIMEOUT_MS=3000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=1000
AI_PROVIDER_OPENAI_URL=https://api.openai.com/v1/chat/completions
AI_PROVIDER_OPENAI_HEALTH_URL=https://api.openai.com/v1/models
AI_PROVIDER_OPENAI_API_KEY=replace-me
AI_PROVIDER_OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
AI_PROVIDER_ANTHROPIC_HEALTH_URL=https://api.anthropic.com/v1/models
AI_PROVIDER_ANTHROPIC_API_KEY=replace-me
AI_PROVIDER_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_PROVIDER_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
AI_PROVIDER_GEMINI_HEALTH_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_PROVIDER_GEMINI_API_KEY=replace-me
